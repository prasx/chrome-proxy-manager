{
  "manifest_version": 3,
  "name": "Proxy Manager",
  "version": "0.8.0",
  "description": "Управление маршрутизацией трафика через локальный proxy",
  "minimum_chrome_version": "108",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "webNavigation",
    "contextMenus",
    "tabs",
    "notifications",
    "privacy",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proxy Manager",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
